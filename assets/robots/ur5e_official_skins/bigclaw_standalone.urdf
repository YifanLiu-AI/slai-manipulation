<robot name="bigclaw_standalone"><link name="base_link" /><link name="bigclaw_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/bigclaw/BIgClaw_simple.stl" />
      </geometry>
      <material name="BigClawMetal">
        <color rgba="0.04 0.04 0.04 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 -1.57079632679" />
      <geometry>
        <mesh filename="meshes/bigclaw/BIgClaw_simple.stl" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.018 -0.01 0.05" rpy="0 0 0" />
      <mass value="0.35" />
      <inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0004" iyz="0" izz="0.00025" />
    </inertial>
  </link>
  <joint name="base_to_claw" type="fixed"><parent link="base_link" /><child link="bigclaw_link" /><origin xyz="0 0 0" rpy="0 0 0" /></joint></robot>