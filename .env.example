# Hardware and experiment settings
SLAMI_DEVICE=cpu
SLAMI_DATA_ROOT=./data

# SenseCore SCO CLI credentials. Copy to the git-ignored .env, chmod 600,
# and never commit or paste real values into scripts/logs.
SCO_ACCESS_KEY_ID=
SCO_ACCESS_KEY_SECRET=
SCO_REGION=cn-sh-01
SCO_ZONE=cn-sh-01z
SCO_PROFILE=default
